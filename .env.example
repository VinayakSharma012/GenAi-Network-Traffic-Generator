# Backend Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PYTHONUNBUFFERED=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=10000
API_WORKERS=2
API_TIMEOUT=120

# Frontend Configuration (for single-website deployment)
# Frontend is served from backend/static folder
# No separate VITE_API_URL needed - API is on same domain
API_BASE_URL=/api

# Optional: Add your own configuration
# CUSTOM_LOG_PATH=/var/log/traffic_log.txt
# CUSTOM_PROTOCOL_TIMEOUT=30
